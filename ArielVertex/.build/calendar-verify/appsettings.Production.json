{
  "//": "Production template. Do NOT put real secrets here — supply them via environment variables",
  "//secrets": "Env override examples: ConnectionStrings__Default, Jwt__Secret, AzureAd__ClientSecret",
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Default": "Host=db;Database=arielvertex;Username=arielvertex;Password=CHANGE_ME"
  },
  "Cors": {
    "Origins": [ "https://portal.arielsoftwares.in" ]
  },
  "EnforceHttps": false,
  "Jwt": {
    "Issuer": "ariel-vertex",
    "Audience": "ariel-vertex-client",
    "Secret": "SET_VIA_ENV__Jwt__Secret",
    "ExpiryHours": 8
  },
  "Auth": {
    "Mode": "Entra",
    "AllowedDomain": "arielsoftwares.in",
    "SeedPassword": "SET_VIA_ENV__Auth__SeedPassword"
  },
  "Integration": {
    "GraphMeetingsLive": true,
    "DirectorySyncLive": true,
    "OutlookNotificationsLive": true
  },
  "AzureAd": {
    "TenantId": "SET_VIA_ENV__AzureAd__TenantId",
    "ClientId": "SET_VIA_ENV__AzureAd__ClientId",
    "ClientSecret": "SET_VIA_ENV__AzureAd__ClientSecret",
    "Instance": "https://login.microsoftonline.com/",
    "GraphBaseUrl": "https://graph.microsoft.com/v1.0",
    "ServiceUser": "operations@arielsoftwares.in"
  },
  "Storage": {
    "Root": "/data/uploads",
    "MaxBytes": 26214400
  },
  "Automation": {
    "Enabled": true,
    "IntervalMinutes": 360
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
