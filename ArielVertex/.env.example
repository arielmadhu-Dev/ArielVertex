# Copy to .env and fill in. docker-compose reads these. NEVER commit the real .env.

# --- Core ---
DB_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-a-long-random-secret-and-rotate
PUBLIC_ORIGIN=https://portal.arielsoftwares.in
SEED_PASSWORD=Ariel@123
ALLOWED_DOMAIN=arielsoftwares.in

# --- Auth mode: Local (seeded logins) or Entra (Microsoft only) ---
AUTH_MODE=Local

# --- Microsoft 365 (from your Entra app registration; leave blank to stay in Local mode) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SERVICE_USER=operations@arielsoftwares.in

# Flip these to true once Azure values are set + admin consent granted.
DIRECTORY_SYNC_LIVE=false
GRAPH_MEETINGS_LIVE=false
OUTLOOK_NOTIFICATIONS_LIVE=false
